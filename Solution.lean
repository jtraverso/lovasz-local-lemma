module

public import Mathlib
public import LocalLemmaLib.LocalLemma

/-!
# Proofs of the statements in `Challenge.lean`

The theorems are proved in `LocalLemmaLib/` (namespace `LocalLemma`). `LocalLemma.lean` proves the
general Local Lemma by strong induction on the conditioning set `S`, showing
`P(C_S ∩ A i) ≤ x i · P(C_S)` for `C_S = ⋂_{j ∈ S} (A j)ᶜ` and `i ∉ S` (the non-neighbours of `i`
are split off with the independence hypothesis), and a chain rule for the product lower bound;
the symmetric form takes `x i = 1/(d + 2)`. `Coin.lean` builds independent fair coin flips on
`ι → Bool` (Mathlib's product measures and `iIndepFun_pi`), shows that events depending on
disjoint sets of coordinates form a dependency graph, and bounds the probability that a set of
coordinates is monochromatic; Spencer's bound colours the pairs of `Fin n`, and property B
colours the vertices occurring in `H`. The definition below is the same as
`LocalLemma.IsDependencyGraph` in the library.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

namespace LovaszLocalLemma

/-- `A i` is mutually independent of the events `A j` with `j ≠ i` not adjacent to `i` in `Γ`:
the σ-algebra generated by `A i` is independent of the one generated by these events. -/
def IsDependencyGraph {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {n : ℕ}
    (A : Fin n → Set Ω) (Γ : SimpleGraph (Fin n)) : Prop :=
  ∀ i, Indep (MeasurableSpace.generateFrom {A i})
    (MeasurableSpace.generateFrom {s | ∃ j, j ≠ i ∧ ¬ Γ.Adj i j ∧ s = A j}) μ

/-- **The Lovász Local Lemma, general form.** -/
theorem lll {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] {n : ℕ}
    (A : Fin n → Set Ω) (hA : ∀ i, MeasurableSet (A i)) (Γ : SimpleGraph (Fin n))
    [DecidableRel Γ.Adj] (hΓ : IsDependencyGraph μ A Γ) (x : Fin n → ℝ) (hx0 : ∀ i, 0 ≤ x i)
    (hx1 : ∀ i, x i < 1)
    (hP : ∀ i, μ.real (A i) ≤ x i * ∏ j ∈ Γ.neighborFinset i, (1 - x j)) :
    ∏ i, (1 - x i) ≤ μ.real (⋂ i, (A i)ᶜ) :=
  LocalLemma.lll μ A hA Γ hΓ x hx0 hx1 hP

/-- **The symmetric Lovász Local Lemma.** -/
theorem lll_symmetric {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {n : ℕ} (A : Fin n → Set Ω) (hA : ∀ i, MeasurableSet (A i)) (Γ : SimpleGraph (Fin n))
    [DecidableRel Γ.Adj] (hΓ : IsDependencyGraph μ A Γ) {p : ℝ} {d : ℕ}
    (hp : ∀ i, μ.real (A i) ≤ p) (hd : ∀ i, Γ.degree i ≤ d)
    (hc : Real.exp 1 * p * (d + 1) ≤ 1) :
    0 < μ.real (⋂ i, (A i)ᶜ) :=
  LocalLemma.lll_symmetric μ A hA Γ hΓ hp hd hc

/-- **Spencer's Ramsey lower bound.** If `2 e (C(k,2) C(n,k-2) + 1) ≤ 2^C(k,2)`, some graph on
`n` vertices has no clique and no independent set of size `k`. -/
theorem ramsey_lower {n k : ℕ}
    (h : 2 * Real.exp 1 * ((k.choose 2 * n.choose (k - 2) : ℕ) + 1) ≤ 2 ^ k.choose 2) :
    ∃ G : SimpleGraph (Fin n), G.CliqueFree k ∧ Gᶜ.CliqueFree k :=
  LocalLemma.ramsey_lower h

/-- **Property B (Erdős–Lovász 1975).** A `k`-uniform hypergraph in which every edge meets at most
`d` other edges, with `e (d + 1) ≤ 2^(k-1)`, has a 2-colouring with no monochromatic edge. -/
theorem propertyB {V : Type*} [DecidableEq V] (H : Finset (Finset V)) {k d : ℕ}
    (hk : ∀ e ∈ H, e.card = k)
    (hd : ∀ e ∈ H, (H.filter fun f => f ≠ e ∧ ¬ Disjoint e f).card ≤ d)
    (h : Real.exp 1 * (d + 1) ≤ 2 ^ (k - 1)) :
    ∃ c : V → Bool, ∀ e ∈ H, ∃ x ∈ e, ∃ y ∈ e, c x ≠ c y :=
  LocalLemma.propertyB H hk hd h

/-- For `k ≥ 9`, a `k`-uniform hypergraph in which every vertex lies in at most `k` edges is
2-colourable. -/
theorem propertyB_regular {V : Type*} [DecidableEq V] (H : Finset (Finset V)) {k : ℕ}
    (h9 : 9 ≤ k) (hk : ∀ e ∈ H, e.card = k) (hdeg : ∀ v, (H.filter fun e => v ∈ e).card ≤ k) :
    ∃ c : V → Bool, ∀ e ∈ H, ∃ x ∈ e, ∃ y ∈ e, c x ≠ c y :=
  LocalLemma.propertyB_regular H h9 hk hdeg

end LovaszLocalLemma
