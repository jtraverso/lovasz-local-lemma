/-!
# The Lovász Local Lemma and two applications

Let `A 0, …, A (n-1)` be events in a probability space and `Γ` a graph on the indices (a
*dependency graph*) such that each `A i` is mutually independent of the family of events `A j`
with `j ≠ i` not adjacent to `i`: the σ-algebra generated by `A i` is independent of the
σ-algebra generated by those `A j`.

* `LocalLemma.lll`: **the Lovász Local Lemma (Erdős–Lovász 1975; general form, Spencer 1977).**
  If `0 ≤ x i < 1` and `P(A i) ≤ x i ∏_{j ∼ i} (1 − x j)` for every `i`, then
  `P(⋂ i, (A i)ᶜ) ≥ ∏ i, (1 − x i)`; in particular with positive probability no event occurs.
* `LocalLemma.lll_symmetric`: **the symmetric Local Lemma.** If every `A i` has probability at
  most `p`, every vertex of `Γ` has degree at most `d`, and `e p (d + 1) ≤ 1`, then
  `P(⋂ i, (A i)ᶜ) > 0`.
* `LocalLemma.ramsey_lower`: **Spencer's Ramsey lower bound (1977).** If
  `2 e (C(k,2) C(n,k-2) + 1) ≤ 2^C(k,2)`, then there is a graph on `n` vertices with neither a
  clique nor an independent set of size `k`; so `R(k,k) > n`.
* `LocalLemma.propertyB`: **Erdős–Lovász (1975).** A `k`-uniform hypergraph in which every edge
  meets at most `d` other edges, with `e (d + 1) ≤ 2^(k-1)`, is 2-colourable (has property B).
* `LocalLemma.propertyB_regular`: for `k ≥ 9`, a `k`-uniform hypergraph in which every vertex
  lies in at most `k` edges is 2-colourable.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory

namespace LocalLemma

/-- `A i` is mutually independent of the events `A j` with `j ≠ i` not adjacent to `i` in `Γ`:
the σ-algebra generated by `A i` is independent of the one generated by these events. -/
def IsDependencyGraph {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {n : ℕ}
    (A : Fin n → Set Ω) (Γ : SimpleGraph (Fin n)) : Prop :=
  ∀ i, Indep (MeasurableSpace.generateFrom {A i})
    (MeasurableSpace.generateFrom {s | ∃ j, j ≠ i ∧ ¬ Γ.Adj i j ∧ s = A j}) μ

/-- The event that none of the `A j`, `j ∈ S`, occurs. -/
def avoid {Ω : Type*} {n : ℕ} (A : Fin n → Set Ω) (S : Finset (Fin n)) : Set Ω :=
  ⋂ j ∈ S, (A j)ᶜ

lemma avoid_insert {Ω : Type*} {n : ℕ} (A : Fin n → Set Ω) (S : Finset (Fin n)) (j : Fin n) :
    avoid A (insert j S) = avoid A S \ A j := by
  ext ω; simp [avoid, and_comm]

lemma avoid_anti {Ω : Type*} {n : ℕ} (A : Fin n → Set Ω) {S T : Finset (Fin n)} (h : S ⊆ T) :
    avoid A T ⊆ avoid A S := by
  intro ω hω
  simp only [avoid, Set.mem_iInter] at hω ⊢
  exact fun j hj => hω j (h hj)

lemma measureReal_avoid_insert {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    [IsFiniteMeasure μ] {n : ℕ} (A : Fin n → Set Ω) (hA : ∀ i, MeasurableSet (A i))
    (S : Finset (Fin n)) (j : Fin n) :
    μ.real (avoid A (insert j S)) = μ.real (avoid A S) - μ.real (avoid A S ∩ A j) := by
  rw [avoid_insert]
  have := measureReal_inter_add_sdiff (μ := μ) (s := avoid A S) (hA j)
  linarith

/-- The chain-rule step of the Local Lemma. -/
lemma lll_chain {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsFiniteMeasure μ] {n : ℕ}
    (A : Fin n → Set Ω) (hA : ∀ i, MeasurableSet (A i)) (x : Fin n → ℝ) (hx1 : ∀ i, x i < 1)
    (S : Finset (Fin n))
    (hH : ∀ T ⊂ S, ∀ i ∉ T, μ.real (avoid A T ∩ A i) ≤ x i * μ.real (avoid A T)) :
    ∀ V ⊆ S, (∏ j ∈ V, (1 - x j)) * μ.real (avoid A (S \ V)) ≤ μ.real (avoid A S) := by
  intro V
  induction V using Finset.induction_on with
  | empty => intro _; simp
  | insert j V hjV ih =>
    intro hsub
    have hj : j ∈ S := hsub (Finset.mem_insert_self _ _)
    have hV : V ⊆ S := (Finset.subset_insert _ _).trans hsub
    have hjU : j ∉ S \ insert j V := by simp
    have hUS : S \ insert j V ⊂ S :=
      (Finset.ssubset_iff_of_subset Finset.sdiff_subset).2 ⟨j, hj, hjU⟩
    have hU : S \ V = insert j (S \ insert j V) := by
      ext y; simp only [Finset.mem_sdiff, Finset.mem_insert]
      constructor
      · rintro ⟨h1, h2⟩; by_cases hy : y = j
        · exact Or.inl hy
        · exact Or.inr ⟨h1, by tauto⟩
      · rintro (rfl | ⟨h1, h2⟩)
        · exact ⟨hj, hjV⟩
        · exact ⟨h1, by tauto⟩
    have key := hH _ hUS j hjU
    have e := measureReal_avoid_insert μ A hA (S \ insert j V) j
    have ih' := ih hV
    rw [hU, e] at ih'
    have hprod : 0 ≤ ∏ j ∈ V, (1 - x j) :=
      Finset.prod_nonneg fun i _ => by linarith [hx1 i]
    rw [Finset.prod_insert hjV]
    calc (1 - x j) * (∏ j ∈ V, (1 - x j)) * μ.real (avoid A (S \ insert j V))
        = (∏ j ∈ V, (1 - x j)) * ((1 - x j) * μ.real (avoid A (S \ insert j V))) := by ring
      _ ≤ (∏ j ∈ V, (1 - x j)) * (μ.real (avoid A (S \ insert j V)) -
            μ.real (avoid A (S \ insert j V) ∩ A j)) := by
          apply mul_le_mul_of_nonneg_left _ hprod; linarith
      _ ≤ _ := ih'

/-- The main inductive claim of the Local Lemma, in product form. -/
lemma lll_cond {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] {n : ℕ}
    (A : Fin n → Set Ω) (hA : ∀ i, MeasurableSet (A i)) (Γ : SimpleGraph (Fin n))
    [DecidableRel Γ.Adj] (hΓ : IsDependencyGraph μ A Γ) (x : Fin n → ℝ) (hx0 : ∀ i, 0 ≤ x i)
    (hx1 : ∀ i, x i < 1)
    (hP : ∀ i, μ.real (A i) ≤ x i * ∏ j ∈ Γ.neighborFinset i, (1 - x j)) :
    ∀ S : Finset (Fin n), ∀ i ∉ S, μ.real (avoid A S ∩ A i) ≤ x i * μ.real (avoid A S) := by
  intro S
  induction S using Finset.strongInduction with
  | H S ih =>
  intro i hi
  set S₂ := S.filter (fun j => ¬ Γ.Adj i j) with hS₂
  have hS₂S : S₂ ⊆ S := Finset.filter_subset _ _
  have h1 : μ.real (avoid A S ∩ A i) ≤ μ.real (avoid A S₂ ∩ A i) :=
    measureReal_mono (Set.inter_subset_inter_left _ (avoid_anti A hS₂S))
  have hm1 : MeasurableSet[MeasurableSpace.generateFrom {A i}] (A i) :=
    MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton _)
  have hm2 : MeasurableSet[MeasurableSpace.generateFrom
      {s | ∃ j, j ≠ i ∧ ¬ Γ.Adj i j ∧ s = A j}] (avoid A S₂) := by
    have : ∀ j ∈ S₂, MeasurableSet[MeasurableSpace.generateFrom
        {s | ∃ j, j ≠ i ∧ ¬ Γ.Adj i j ∧ s = A j}] (A j)ᶜ := by
      intro j hj
      rw [hS₂, Finset.mem_filter] at hj
      refine MeasurableSet.compl (MeasurableSpace.measurableSet_generateFrom ?_)
      exact ⟨j, fun h => hi (h ▸ hj.1), hj.2, rfl⟩
    exact Finset.measurableSet_biInter _ this
  have h2 : μ.real (avoid A S₂ ∩ A i) = μ.real (A i) * μ.real (avoid A S₂) := by
    have := (Indep_iff _ _ μ).1 (hΓ i) (A i) (avoid A S₂) hm1 hm2
    rw [Set.inter_comm]
    simp only [Measure.real, this, ENNReal.toReal_mul]
  have hsub : S \ S₂ ⊆ Γ.neighborFinset i := by
    intro j hj
    simp only [hS₂, Finset.mem_sdiff, Finset.mem_filter, not_and, not_not] at hj
    simpa using hj.2 hj.1
  have h3 : ∏ j ∈ Γ.neighborFinset i, (1 - x j) ≤ ∏ j ∈ S \ S₂, (1 - x j) := by
    rw [← Finset.prod_sdiff hsub]
    have h0 : 0 ≤ ∏ j ∈ S \ S₂, (1 - x j) := Finset.prod_nonneg fun j _ => by linarith [hx1 j]
    have hle : ∏ j ∈ Γ.neighborFinset i \ (S \ S₂), (1 - x j) ≤ 1 :=
      Finset.prod_le_one₀ (fun j _ => by linarith [hx1 j]) (fun j _ => by linarith [hx0 j])
    nlinarith
  have h4 := lll_chain μ A hA x hx1 S ih (S \ S₂) Finset.sdiff_subset
  rw [Finset.sdiff_sdiff_eq_self hS₂S] at h4
  have hμ : 0 ≤ μ.real (avoid A S₂) := measureReal_nonneg
  calc μ.real (avoid A S ∩ A i) ≤ μ.real (A i) * μ.real (avoid A S₂) := h1.trans h2.le
    _ ≤ (x i * ∏ j ∈ Γ.neighborFinset i, (1 - x j)) * μ.real (avoid A S₂) :=
        mul_le_mul_of_nonneg_right (hP i) hμ
    _ ≤ (x i * ∏ j ∈ S \ S₂, (1 - x j)) * μ.real (avoid A S₂) := by
        gcongr; exact hx0 i
    _ = x i * ((∏ j ∈ S \ S₂, (1 - x j)) * μ.real (avoid A S₂)) := by ring
    _ ≤ x i * μ.real (avoid A S) := mul_le_mul_of_nonneg_left h4 (hx0 i)

/-- **The Lovász Local Lemma, general form.** -/
theorem lll {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] {n : ℕ}
    (A : Fin n → Set Ω) (hA : ∀ i, MeasurableSet (A i)) (Γ : SimpleGraph (Fin n))
    [DecidableRel Γ.Adj] (hΓ : IsDependencyGraph μ A Γ) (x : Fin n → ℝ) (hx0 : ∀ i, 0 ≤ x i)
    (hx1 : ∀ i, x i < 1)
    (hP : ∀ i, μ.real (A i) ≤ x i * ∏ j ∈ Γ.neighborFinset i, (1 - x j)) :
    ∏ i, (1 - x i) ≤ μ.real (⋂ i, (A i)ᶜ) := by
  have h := lll_chain μ A hA x hx1 Finset.univ
    (fun T _ => lll_cond μ A hA Γ hΓ x hx0 hx1 hP T) Finset.univ subset_rfl
  simpa [avoid] using h

/-- The numerical inequality behind the symmetric Local Lemma. -/
lemma exp_mul_pow_ge_one (d : ℕ) : 1 ≤ Real.exp 1 * (((d:ℝ) + 1) / ((d:ℝ) + 2)) ^ (d + 1) := by
  set t : ℝ := 1 / ((d:ℝ) + 1) with ht
  have hd : (0:ℝ) < (d:ℝ) + 1 := by positivity
  have h1 : (1 + t) ^ (d + 1) ≤ Real.exp 1 := by
    calc (1 + t) ^ (d + 1) ≤ Real.exp t ^ (d + 1) := by
          gcongr; linarith [Real.add_one_le_exp t]
      _ = Real.exp 1 := by
          rw [← Real.exp_nat_mul]; congr 1; rw [ht]; push_cast; field_simp
  have h2 : ((d:ℝ) + 1) / ((d:ℝ) + 2) = (1 + t)⁻¹ := by
    rw [ht]; field_simp; ring
  rw [h2, inv_pow]
  have h3 : 0 < (1 + t) ^ (d + 1) := by positivity
  rw [← div_eq_mul_inv, le_div_iff₀ h3]; linarith

/-- **The symmetric Lovász Local Lemma.** -/
theorem lll_symmetric {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {n : ℕ} (A : Fin n → Set Ω) (hA : ∀ i, MeasurableSet (A i)) (Γ : SimpleGraph (Fin n))
    [DecidableRel Γ.Adj] (hΓ : IsDependencyGraph μ A Γ) {p : ℝ} {d : ℕ}
    (hp : ∀ i, μ.real (A i) ≤ p) (hd : ∀ i, Γ.degree i ≤ d)
    (hc : Real.exp 1 * p * (d + 1) ≤ 1) :
    0 < μ.real (⋂ i, (A i)ᶜ) := by
  have hd2 : (0:ℝ) < (d:ℝ) + 2 := by positivity
  have hd1 : (0:ℝ) < (d:ℝ) + 1 := by positivity
  have hr : 1 - 1 / ((d:ℝ) + 2) = ((d:ℝ) + 1) / ((d:ℝ) + 2) := by field_simp; ring
  have hr0 : 0 < ((d:ℝ) + 1) / ((d:ℝ) + 2) := by positivity
  have hr1 : ((d:ℝ) + 1) / ((d:ℝ) + 2) ≤ 1 := by rw [div_le_one hd2]; linarith
  have hx1 : ∀ _ : Fin n, 1 / ((d:ℝ) + 2) < 1 := fun _ => by
    rw [div_lt_one hd2]; linarith [(Nat.cast_nonneg d : (0:ℝ) ≤ d)]
  refine lt_of_lt_of_le ?_
    (lll μ A hA Γ hΓ (fun _ => 1 / ((d:ℝ) + 2)) (fun _ => by positivity) hx1 ?_)
  · exact Finset.prod_pos fun i _ => by rw [hr]; exact hr0
  · intro i
    rw [Finset.prod_const, SimpleGraph.card_neighborFinset_eq_degree, hr]
    have hpe : p ≤ 1 / (Real.exp 1 * ((d:ℝ) + 1)) := by
      rw [le_div_iff₀ (by positivity)]; linarith
    have key := exp_mul_pow_ge_one d
    have hpow : (((d:ℝ) + 1) / ((d:ℝ) + 2)) ^ d ≤ (((d:ℝ) + 1) / ((d:ℝ) + 2)) ^ Γ.degree i :=
      pow_le_pow_of_le_one hr0.le hr1 (hd i)
    calc μ.real (A i) ≤ p := hp i
      _ ≤ 1 / (Real.exp 1 * ((d:ℝ) + 1)) := hpe
      _ ≤ 1 / ((d:ℝ) + 2) * (((d:ℝ) + 1) / ((d:ℝ) + 2)) ^ d := by
          rw [div_le_iff₀ (by positivity)]
          have : 1 / ((d:ℝ) + 2) * (((d:ℝ) + 1) / ((d:ℝ) + 2)) ^ d * (Real.exp 1 * ((d:ℝ) + 1))
              = Real.exp 1 * (((d:ℝ) + 1) / ((d:ℝ) + 2)) ^ (d + 1) := by
            rw [pow_succ]; field_simp
          rw [this]; exact key
      _ ≤ _ := by gcongr


/-- A colouring avoiding all monochromatic coordinate sets, via the symmetric Local Lemma. -/
lemma exists_good_coloring {ι : Type*} [Finite ι] {m : ℕ} (D : Fin m → Finset ι)
    (Γ : SimpleGraph (Fin m)) [DecidableRel Γ.Adj]
    (hΓ : ∀ i j, j ≠ i → ¬ Γ.Adj i j → Disjoint (D i) (D j)) {d k : ℕ}
    (hD : ∀ i, k ≤ (D i).card) (hd : ∀ i, Γ.degree i ≤ d)
    (hc : Real.exp 1 * (2 * (1 / 2) ^ k) * (d + 1) ≤ 1) :
    ∃ ω : ι → Bool, ∀ i, ¬ ∃ b, ∀ v ∈ D i, ω v = b := by
  have := Fintype.ofFinite ι
  set A : Fin m → Set (ι → Bool) := fun i => {ω | ∃ b, ∀ v ∈ D i, ω v = b} with hAdef
  have hdep : IsDependencyGraph (coinMeasure ι) A Γ := by
    refine coin_dependency A D (fun i ω ω' h hω => ?_) Γ hΓ
    obtain ⟨b, hb⟩ := hω
    exact ⟨b, fun v hv => (h v hv).symm.trans (hb v hv)⟩
  have hp : ∀ i, (coinMeasure ι).real (A i) ≤ 2 * (1 / 2) ^ k := by
    intro i
    refine (coin_mono_le (D i)).trans ?_
    exact mul_le_mul_of_nonneg_left (pow_le_pow_of_le_one (by norm_num) (by norm_num) (hD i))
      (by norm_num)
  have hpos := lll_symmetric (coinMeasure ι) A (fun _ => (Set.toFinite _).measurableSet) Γ hdep
    hp hd hc
  obtain ⟨ω, hω⟩ : (⋂ i, (A i)ᶜ).Nonempty := by
    by_contra hne
    rw [Set.not_nonempty_iff_eq_empty] at hne
    rw [hne] at hpos
    simp at hpos
  refine ⟨ω, fun i => ?_⟩
  have := Set.mem_iInter.1 hω i
  exact this

/-- Number of `k`-subsets of `Fin n` containing a fixed pair. -/
lemma card_filter_superset_le {n k : ℕ} (e : Finset (Fin n)) (he : e.card = 2) :
    (((Finset.univ : Finset (Fin n)).powersetCard k).filter (e ⊆ ·)).card ≤
      n.choose (k - 2) := by
  classical
  have : ((Finset.univ : Finset (Fin n)).powersetCard (k - 2)).card = n.choose (k - 2) := by
    simp
  rw [← this]
  refine Finset.card_le_card_of_injOn (· \ e) ?_ ?_
  · intro T hT
    have hT' := Finset.mem_filter.1 (Finset.mem_coe.1 hT)
    rw [Finset.mem_coe, Finset.mem_powersetCard]
    refine ⟨Finset.subset_univ _, ?_⟩
    rw [Finset.card_sdiff_of_subset hT'.2, (Finset.mem_powersetCard.1 hT'.1).2, he]
  · intro T hT T' hT' h
    have h1 := Finset.sdiff_union_of_subset (Finset.mem_filter.1 (Finset.mem_coe.1 hT)).2
    have h2 := Finset.sdiff_union_of_subset (Finset.mem_filter.1 (Finset.mem_coe.1 hT')).2
    simp only at h
    rw [← h1, ← h2, h]

/-- **Spencer's Ramsey lower bound.** If `2 e (C(k,2) C(n,k-2) + 1) ≤ 2^C(k,2)`, some graph on
`n` vertices has no clique and no independent set of size `k`. -/
theorem ramsey_lower {n k : ℕ}
    (h : 2 * Real.exp 1 * ((k.choose 2 * n.choose (k - 2) : ℕ) + 1) ≤ 2 ^ k.choose 2) :
    ∃ G : SimpleGraph (Fin n), G.CliqueFree k ∧ Gᶜ.CliqueFree k := by
  classical
  set P := (Finset.univ : Finset (Fin n)).powersetCard k with hP
  set f : Fin P.card ≃ P := P.equivFin.symm with hf
  let D : Fin P.card → Finset (Finset (Fin n)) := fun a => (f a).1.powersetCard 2
  let Γ : SimpleGraph (Fin P.card) :=
    SimpleGraph.fromRel fun a b => 2 ≤ ((f a).1 ∩ (f b).1).card
  have hfk : ∀ a, (f a).1.card = k := fun a => (Finset.mem_powersetCard.1 (f a).2).2
  have hΓ : ∀ i j, j ≠ i → ¬ Γ.Adj i j → Disjoint (D i) (D j) := by
    intro i j hji hadj
    have hlt : ¬ 2 ≤ ((f i).1 ∩ (f j).1).card := by
      intro hc
      exact hadj ((SimpleGraph.fromRel_adj _ _ _).2 ⟨hji.symm, Or.inl hc⟩)
    rw [Finset.disjoint_left]
    intro e hei hej
    rw [Finset.mem_powersetCard] at hei hej
    apply hlt
    rw [← hei.2]
    exact Finset.card_le_card (Finset.subset_inter hei.1 hej.1)
  have hD : ∀ a, k.choose 2 ≤ (D a).card := by
    intro a
    simp only [D, Finset.card_powersetCard, hfk]; rfl
  have hdeg : ∀ a, Γ.degree a ≤ k.choose 2 * n.choose (k - 2) := by
    intro a
    rw [← SimpleGraph.card_neighborFinset_eq_degree]
    have hsub : (Γ.neighborFinset a).image (fun b => (f b).1) ⊆
        ((f a).1.powersetCard 2).biUnion (fun e => P.filter (e ⊆ ·)) := by
      intro T hT
      obtain ⟨b, hb, rfl⟩ := Finset.mem_image.1 hT
      rw [SimpleGraph.mem_neighborFinset, SimpleGraph.fromRel_adj] at hb
      have h2 : 2 ≤ ((f a).1 ∩ (f b).1).card := by
        rcases hb.2 with h' | h'
        · exact h'
        · rwa [Finset.inter_comm]
      obtain ⟨e, he, hec⟩ := Finset.exists_subset_card_eq h2
      rw [Finset.mem_biUnion]
      refine ⟨e, Finset.mem_powersetCard.2 ⟨he.trans Finset.inter_subset_left, hec⟩, ?_⟩
      rw [Finset.mem_filter]
      exact ⟨(f b).2, he.trans Finset.inter_subset_right⟩
    rw [← Finset.card_image_of_injective _ (fun b b' he => f.injective (Subtype.ext he))]
    refine (Finset.card_le_card hsub).trans (Finset.card_biUnion_le.trans ?_)
    refine (Finset.sum_le_card_nsmul _ _ (n.choose (k - 2)) fun e he => ?_).trans ?_
    · exact card_filter_superset_le e (Finset.mem_powersetCard.1 he).2
    · simp [hfk]
  have hc : Real.exp 1 * (2 * (1 / 2) ^ k.choose 2) *
      (((k.choose 2 * n.choose (k - 2) : ℕ) : ℝ) + 1) ≤ 1 := by
    rw [one_div_pow, mul_one_div, mul_div_assoc', div_mul_eq_mul_div,
      div_le_one (by positivity)]
    linarith
  obtain ⟨ω, hω⟩ := exists_good_coloring D Γ hΓ hD hdeg hc
  let G : SimpleGraph (Fin n) := SimpleGraph.fromRel fun u v => ω {u, v} = true
  have key : ∀ S : Finset (Fin n), S.card = k → ∀ b : Bool,
      (∀ u ∈ S, ∀ v ∈ S, u ≠ v → ω {u, v} = b) → False := by
    intro S hS b hb
    have hSP : S ∈ P := Finset.mem_powersetCard.2 ⟨Finset.subset_univ _, hS⟩
    apply hω (f.symm ⟨S, hSP⟩)
    refine ⟨b, fun e he => ?_⟩
    simp only [D, Equiv.apply_symm_apply, Finset.mem_powersetCard] at he
    obtain ⟨u, v, huv, rfl⟩ := Finset.card_eq_two.1 he.2
    exact hb u (he.1 (by simp)) v (he.1 (by simp)) huv
  refine ⟨G, fun S hS => ?_, fun S hS => ?_⟩
  · refine key S hS.card_eq true fun u hu v hv huv => ?_
    have := ((SimpleGraph.fromRel_adj _ _ _).1 (hS.isClique hu hv huv)).2
    rcases this with h' | h'
    · exact h'
    · rwa [Finset.pair_comm]
  · refine key S hS.card_eq false fun u hu v hv huv => ?_
    have := hS.isClique hu hv huv
    rw [SimpleGraph.compl_adj, SimpleGraph.fromRel_adj] at this
    have h' : ¬ ω {u, v} = true := fun h' => this.2 ⟨huv, Or.inl h'⟩
    simpa using h'

/-- **Property B (Erdős–Lovász 1975).** A `k`-uniform hypergraph in which every edge meets at most
`d` other edges, with `e (d + 1) ≤ 2^(k-1)`, has a 2-colouring with no monochromatic edge. -/
theorem propertyB {V : Type*} [DecidableEq V] (H : Finset (Finset V)) {k d : ℕ}
    (hk : ∀ e ∈ H, e.card = k)
    (hd : ∀ e ∈ H, (H.filter fun f => f ≠ e ∧ ¬ Disjoint e f).card ≤ d)
    (h : Real.exp 1 * (d + 1) ≤ 2 ^ (k - 1)) :
    ∃ c : V → Bool, ∀ e ∈ H, ∃ x ∈ e, ∃ y ∈ e, c x ≠ c y := by
  classical
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := by
    rcases k with _ | j
    · exfalso
      simp only [zero_tsub, pow_zero] at h
      have h1 : 1 + 1 < Real.exp 1 := Real.add_one_lt_exp one_ne_zero
      have h2 : (0:ℝ) ≤ d := Nat.cast_nonneg d
      nlinarith
    · exact ⟨j, rfl⟩
  simp only [add_tsub_cancel_right] at h
  set W := H.biUnion id with hW
  set f : Fin H.card ≃ H := H.equivFin.symm with hf
  let D : Fin H.card → Finset {v // v ∈ W} := fun a => (f a).1.subtype (· ∈ W)
  have hfW : ∀ a, ∀ v ∈ (f a).1, v ∈ W := fun a v hv =>
    Finset.mem_biUnion.2 ⟨(f a).1, (f a).2, hv⟩
  let Γ : SimpleGraph (Fin H.card) := SimpleGraph.fromRel fun a b => ¬ Disjoint (f a).1 (f b).1
  have hΓ : ∀ i j, j ≠ i → ¬ Γ.Adj i j → Disjoint (D i) (D j) := by
    intro i j hji hadj
    have hdis : Disjoint (f i).1 (f j).1 := by
      by_contra hc
      exact hadj ((SimpleGraph.fromRel_adj _ _ _).2 ⟨hji.symm, Or.inl hc⟩)
    rw [Finset.disjoint_left]
    intro v hvi hvj
    rw [Finset.mem_subtype] at hvi hvj
    exact Finset.disjoint_left.1 hdis hvi hvj
  have hD : ∀ a, j + 1 ≤ (D a).card := by
    intro a
    simp only [D, Finset.card_subtype]
    rw [Finset.filter_true_of_mem (hfW a), hk _ (f a).2]
  have hdeg : ∀ a, Γ.degree a ≤ d := by
    intro a
    rw [← SimpleGraph.card_neighborFinset_eq_degree]
    refine le_trans ?_ (hd (f a).1 (f a).2)
    refine Finset.card_le_card_of_injOn (fun b => (f b).1) ?_ ?_
    · intro b hb
      rw [Finset.mem_coe, SimpleGraph.mem_neighborFinset, SimpleGraph.fromRel_adj] at hb
      rw [Finset.mem_coe, Finset.mem_filter]
      refine ⟨(f b).2, fun he => hb.1 (f.injective (Subtype.ext he.symm)), ?_⟩
      rcases hb.2 with h' | h'
      · exact h'
      · exact fun h'' => h' h''.symm
    · intro b _ b' _ he
      exact f.injective (Subtype.ext he)
  have hc : Real.exp 1 * (2 * (1 / 2) ^ (j + 1)) * (d + 1) ≤ 1 := by
    have h2 : (2:ℝ) * (1 / 2) ^ (j + 1) = 1 / 2 ^ j := by
      rw [pow_succ, one_div_pow]; field_simp
    rw [h2, mul_one_div, div_mul_eq_mul_div, div_le_one (by positivity)]
    exact h
  obtain ⟨ω, hω⟩ := exists_good_coloring D Γ hΓ hD hdeg hc
  refine ⟨fun v => if hv : v ∈ W then ω ⟨v, hv⟩ else true, fun e he => ?_⟩
  by_contra hne
  push Not at hne
  set a := f.symm ⟨e, he⟩
  have hfa : (f a).1 = e := by simp [a]
  apply hω a
  rcases e.eq_empty_or_nonempty with h0 | ⟨x0, hx0⟩
  · refine ⟨true, fun v hv => ?_⟩
    rw [Finset.mem_subtype, hfa, h0] at hv
    simp at hv
  · refine ⟨if hv : x0 ∈ W then ω ⟨x0, hv⟩ else true, fun v hv => ?_⟩
    rw [Finset.mem_subtype, hfa] at hv
    have := hne v hv x0 hx0
    simpa [v.2] using this

/-- `e (k (k - 1) + 1) ≤ 2 ^ (k - 1)` for `k ≥ 9`. -/
lemma exp_regular_bound (k : ℕ) (hk : 9 ≤ k) :
    Real.exp 1 * (((k * (k - 1) : ℕ) : ℝ) + 1) ≤ 2 ^ (k - 1) := by
  induction k, hk using Nat.le_induction with
  | base => norm_num; linarith [Real.exp_one_lt_d9]
  | succ m hm ih =>
    obtain ⟨j, rfl⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
    have hj : (8:ℝ) ≤ j := by exact_mod_cast (by omega : 8 ≤ j)
    have hstep : (((j + 1 + 1) * (j + 1 + 1 - 1) : ℕ) : ℝ) + 1 ≤
        2 * ((((j + 1) * (j + 1 - 1) : ℕ) : ℝ) + 1) := by
      simp only [Nat.add_sub_cancel]
      push_cast
      nlinarith
    have he : 0 ≤ Real.exp 1 := (Real.exp_pos 1).le
    calc Real.exp 1 * ((((j + 1 + 1) * (j + 1 + 1 - 1) : ℕ) : ℝ) + 1)
        ≤ Real.exp 1 * (2 * ((((j + 1) * (j + 1 - 1) : ℕ) : ℝ) + 1)) :=
          mul_le_mul_of_nonneg_left hstep he
      _ = 2 * (Real.exp 1 * ((((j + 1) * (j + 1 - 1) : ℕ) : ℝ) + 1)) := by ring
      _ ≤ 2 * 2 ^ (j + 1 - 1) := by linarith
      _ = 2 ^ (j + 1 + 1 - 1) := by simp [pow_succ]; ring

/-- For `k ≥ 9`, a `k`-uniform hypergraph in which every vertex lies in at most `k` edges is
2-colourable. -/
theorem propertyB_regular {V : Type*} [DecidableEq V] (H : Finset (Finset V)) {k : ℕ}
    (h9 : 9 ≤ k) (hk : ∀ e ∈ H, e.card = k) (hdeg : ∀ v, (H.filter fun e => v ∈ e).card ≤ k) :
    ∃ c : V → Bool, ∀ e ∈ H, ∃ x ∈ e, ∃ y ∈ e, c x ≠ c y := by
  refine propertyB H hk (d := k * (k - 1)) (fun e he => ?_) (exp_regular_bound k h9)
  calc (H.filter fun f => f ≠ e ∧ ¬ Disjoint e f).card
      ≤ (e.biUnion fun v => (H.filter fun f => v ∈ f).erase e).card := by
        apply Finset.card_le_card
        intro f hf
        rw [Finset.mem_filter] at hf
        obtain ⟨v, hve, hvf⟩ := Finset.not_disjoint_iff.1 hf.2.2
        rw [Finset.mem_biUnion]
        exact ⟨v, hve, Finset.mem_erase.2 ⟨hf.2.1, Finset.mem_filter.2 ⟨hf.1, hvf⟩⟩⟩
    _ ≤ ∑ v ∈ e, ((H.filter fun f => v ∈ f).erase e).card := Finset.card_biUnion_le
    _ ≤ e.card • (k - 1) := Finset.sum_le_card_nsmul _ _ _ fun v hv => by
        rw [Finset.card_erase_of_mem (Finset.mem_filter.2 ⟨he, hv⟩)]
        have := hdeg v
        omega
    _ = k * (k - 1) := by rw [hk e he, smul_eq_mul]

end LocalLemma
